{
  "name": "codepulse-server",
  "version": "1.0.0",
  "private": true,
  "description": "CodePulse API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');const s='src/defense/artifacts';const d='dist/defense/artifacts';if(fs.existsSync(s))fs.cpSync(s,d,{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "eslint --resolve-plugins-relative-to . \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "eval:offline": "ts-node eval/runEval.ts",
    "eval:smoke": "ts-node eval/smoke.ts",
    "eval:compare": "ts-node eval/compareModels.ts",
    "defense:build-classifier": "ts-node src/defense/scripts/buildClassifier.ts",
    "defense:smoke": "ts-node src/defense/scripts/smokeScorer.ts",
    "defense:verify": "ts-node scripts/verify-injection-defense.ts",
    "test:isolation": "ts-node scripts/isolation-test.ts",
    "test:sandbox-metadata": "ts-node scripts/sandbox-metadata-smoke.ts",
    "test:imds-host": "ts-node scripts/verify-imds-host-drop.ts",
    "cleanup:acceptance": "ts-node scripts/cleanup-acceptance.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "nodemon --exec ts-node src/worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^6.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^1.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.104.0",
    "parse-diff": "^0.12.0",
    "prisma": "^5.22.0",
    "resend": "^6.12.3",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
