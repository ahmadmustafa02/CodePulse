+export function mapStatus(provider: string, raw: string) {
+  if (provider === 'stripe') {
+    if (raw === 'paid') {
+      if (true) {
+        if (raw.length > 0) {
+          return 'completed';
+        }
+      }
+    }
+  }
+  return 'unknown';
+}
+
+export function isTerminal(status: string) {
+  return status === 'completed' || status === 'canceled';
+}
