@@ -0,0 +1,18 @@
+export type AppConfig = {
+  featureFlags: Record<string, boolean>;
+  timeoutMs: number;
+};
+
+export function parseRemoteConfig(payload: string): AppConfig {
+  const parsed: unknown = JSON.parse(payload);
+  if (!parsed || typeof parsed !== 'object') {
+    throw new Error('Invalid config payload');
+  }
+  const record = parsed as Record<string, unknown>;
+  const timeoutMs = typeof record.timeoutMs === 'number' ? record.timeoutMs : 5000;
+  const featureFlags =
+    record.featureFlags && typeof record.featureFlags === 'object'
+      ? (record.featureFlags as Record<string, boolean>)
+      : {};
+  return { featureFlags, timeoutMs };
+}
