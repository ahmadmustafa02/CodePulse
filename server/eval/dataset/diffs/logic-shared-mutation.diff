+const DEFAULT_TAGS: string[] = [];
+
+export function withTag(tag: string) {
+  // Mutates a module-level array shared across callers.
+  DEFAULT_TAGS.push(tag);
+  return DEFAULT_TAGS;
+}
+
+export function resetTags() {
+  DEFAULT_TAGS.length = 0;
+}
