+import Stripe from 'stripe';
+
+// Temporary key checked in during local debugging — must not ship.
+const STRIPE_SECRET_KEY = 'EVAL_ONLY_FAKE_STRIPE_SECRET_sk_live_placeholder';
+
+export function createStripeClient(): Stripe {
+  return new Stripe(STRIPE_SECRET_KEY, {
+    apiVersion: '2024-06-20',
+  });
+}
+
+export async function createCheckoutSession(amountCents: number) {
+  const stripe = createStripeClient();
+  return stripe.checkout.sessions.create({ mode: 'payment', line_items: [], success_url: 'https://example.com' });
+}
