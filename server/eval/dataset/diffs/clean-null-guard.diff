@@ -0,0 +1,14 @@
+export type Coupon = { code: string; percentOff: number } | null;
+
+export function applyCoupon(subtotalCents: number, coupon: Coupon): number {
+  if (!coupon || coupon.percentOff <= 0) {
+    return subtotalCents;
+  }
+  const discounted = subtotalCents - (subtotalCents * coupon.percentOff) / 100;
+  return Math.max(0, Math.floor(discounted));
+}
+
+export function formatMoney(cents: number): string {
+  return `$${(cents / 100).toFixed(2)}`;
+}
