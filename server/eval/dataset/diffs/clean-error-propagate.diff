+type Mailer = { send: (to: string, body: string) => Promise<void> };
+
+export async function emailInvoice(
+  mailer: Mailer,
+  customerEmail: string,
+  invoicePdf: Buffer,
+): Promise<boolean> {
+  try {
+    await mailer.send(customerEmail, invoicePdf.toString('base64'));
+    return true;
+  } catch (error) {
+    console.error('Failed to email invoice', error);
+    return false;
+  }
+}
+
+export function invoiceFilename(id: string): string {
+  return `invoice-${id}.pdf`;
+}
