@@ -0,0 +1,16 @@
+export type SessionUser = {
+  id: string;
+  role: 'admin' | 'member';
+};
+
+export function readSessionUser(raw: unknown): SessionUser {
+  // Unchecked any-cast hides missing fields at runtime.
+  const user = raw as any;
+  return {
+    id: user.id,
+    role: user.role,
+  };
+}
+
+export function isAdmin(user: SessionUser): boolean {
+  return user.role === 'admin';
+}
