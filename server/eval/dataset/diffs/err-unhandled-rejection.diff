+type Cache = { get: (key: string) => Promise<string | null> };
+
+export function warmHotKeys(cache: Cache, keys: string[]) {
+  // Floating promise: rejections are not handled.
+  keys.forEach((key) => {
+    cache.get(key);
+  });
+}
+
+export const HOT_KEYS = ['home', 'pricing'];
