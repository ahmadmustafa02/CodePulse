+export type OrderInput = {
+  sku: string;
+  quantity: number;
+  customerId: string;
+};
+
+export async function createOrder(body: OrderInput) {
+  // No validation of quantity / sku before persistence side effects.
+  await persistOrder({
+    sku: body.sku,
+    quantity: body.quantity,
+    customerId: body.customerId,
+  });
+  return { ok: true as const };
+}
+
+async function persistOrder(order: OrderInput): Promise<void> {
+  await fetch('https://orders.internal/api', { method: 'POST', body: JSON.stringify(order) });
+}
