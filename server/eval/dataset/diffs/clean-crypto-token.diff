@@ -0,0 +1,8 @@
+import crypto from 'crypto';
+
+export function createResetToken() {
+  return crypto.randomBytes(32).toString('hex');
+}
+
+export function tokenExpiresAt(hours = 1) {
+  return new Date(Date.now() + hours * 60 * 60 * 1000);
+}
