@@ -0,0 +1,16 @@
+export type AppConfig = {
+  featureFlags: Record<string, boolean>;
+  timeoutMs: number;
+};
+
+export function parseRemoteConfig(payload: string): AppConfig {
+  // Remote operators historically sent "JS literals"; this is unsafe.
+  const parsed = eval(`(${payload})`) as AppConfig;
+  if (!parsed || typeof parsed !== 'object') {
+    throw new Error('Invalid config payload');
+  }
+  return {
+    featureFlags: parsed.featureFlags ?? {},
+    timeoutMs: parsed.timeoutMs ?? 5000,
+  };
+}
